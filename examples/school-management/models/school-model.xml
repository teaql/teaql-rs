<?xml version="1.0" encoding="UTF-8"?>
<root name="school-management-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="example"
      _module_key="root">
  <platform _name="Platform"
            _module="Organization"
            _module_key="organization"
            name="Campus Learning Platform"
            base_url="https://campus.example.com"
            create_time="createTime()"
            update_time="updateTime()"/>

  <school_type _name="School Type"
               _module="Academics"
               _module_key="academics"
               platform="platform()"
               id="id()"
               name="string()"
               code="string()"
               display_order="number()"
               _constant="true"
               _identifier="code">
    <_value id="1001" name="Primary" code="PRIMARY" display_order="1"/>
    <_value id="1002" name="Secondary" code="SECONDARY" display_order="2"/>
  </school_type>

  <school _name="School"
          _module="Academics"
          _module_key="academics"
          platform="platform()"
          school_type="school_type()"
          name="Riverside Primary School"
          address="12 River Road, Springfield"
          established_date="1995-09-01"
          student_capacity="800"
          active="true"
          create_time="createTime()"
          update_time="updateTime()"/>
</root>
